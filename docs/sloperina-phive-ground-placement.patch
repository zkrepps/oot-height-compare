+def ground_placements(data, offset, size):
+    """Placement records of the nested ground meshes in one block, or [] if the block isn't one.
+
+    Each record is 11 words (0x2C): scale xyz, three zero words (rotation?), translation xyz, u32 kind (6, 7, 8 seen),
+    u32 0; the block is padded to 0x10. One record = 0x30 block, two = 0x60 (Hyrule Field)."""
+    if size % 0x10 or size < 0x2C:
+        return []
+    out, p, end = [], offset, offset + size
+    while p + 0x2C <= end:
+        f = struct.unpack_from("<9f", data, p)
+        kind, zero = struct.unpack_from("<2I", data, p + 0x24)
+        if not (all(0.001 < abs(v) < 1000 for v in f[0:3]) and f[3:6] == (0.0, 0.0, 0.0) and 0 < kind < 64 and zero == 0):
+            break
+        out.append({"s": f[0:3], "t": f[6:9], "q": (0.0, 0.0, 0.0, 1.0), "kind": kind})
+        p += 0x2C
+    if not out or any(data[p:end].strip(b"\0")):
+        return []
+    return out
+
